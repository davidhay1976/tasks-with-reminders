{
  "name": "Claude Code Hardened Sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "remoteUser": "vscode",
  "containerUser": "vscode",

  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],

  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=codex-config-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=ssh-config-${devcontainerId},target=/home/vscode/.ssh,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },

  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/post-create.sh",
  "postStartCommand": "sudo ${containerWorkspaceFolder}/.devcontainer/init-firewall.sh && (grep -q '^sandbox_mode' /home/vscode/.codex/config.toml 2>/dev/null || sed -i '1i sandbox_mode = \"danger-full-access\"' /home/vscode/.codex/config.toml)",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
